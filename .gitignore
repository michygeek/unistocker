# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ────────────────────────────────────────────────────────────────────
.next/
out/
build/

# ── Prisma generated client ─────────────────────────────────────────────────────
# (regenerated by `prisma generate` / `postinstall` on every fresh install)
/app/generated/prisma
prisma/generated/

# ── Environment variables ───────────────────────────────────────────────────────
# Commit .env.example — ignore everything else
.env
.env.*
!.env.example

# ── Testing & coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Debug logs ─────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── TypeScript ─────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Vercel ─────────────────────────────────────────────────────────────────────
.vercel/

# ── OS generated files ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editors ────────────────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Certificates ───────────────────────────────────────────────────────────────
*.pem

# ── Claude Code local config ────────────────────────────────────────────────────
.claude/
