# ── Database ─────────────────────────────────────────────────────────────────────
# Pooled connection used at runtime (Supabase / Neon / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct (non-pooled) connection — required for Prisma migrations
# Same as DATABASE_URL if you're not behind a pooler (e.g. local Postgres)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Your production URL — e.g. https://app.unistocker.com
# On Vercel this is detected automatically; you can omit it there.
NEXTAUTH_URL="http://localhost:3000"

# ── Redis (BullMQ background queues) ─────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://default:TOKEN@host.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ── Cloudinary (product image uploads) ───────────────────────────────────────────
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Resend (transactional email) ──────────────────────────────────────────────────
# resend.com → API Keys → Create
RESEND_API_KEY=""
# Must be a verified sender in your Resend account.
# Use "onboarding@resend.dev" for local testing only.
FROM_EMAIL="onboarding@resend.dev"

# ── Firebase Admin SDK (server-side push notifications) ───────────────────────────
# console.firebase.google.com → Project Settings → Service Accounts → Generate key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep \n as literal \n — do NOT use real line breaks
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Paystack (billing & subscriptions) ───────────────────────────────────────────
# dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=""
# Create recurring plans in Paystack dashboard → Products → Plans, then paste the plan codes here
PAYSTACK_PRO_PLAN_CODE=""
PAYSTACK_BUSINESS_PLAN_CODE=""
# Webhook URL to register: https://your-domain.com/api/paystack/webhook

# ── Anthropic Claude AI ───────────────────────────────────────────────────────────
# console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=""

# ── Firebase Web App (client-side) ────────────────────────────────────────────────
# console.firebase.google.com → Project Settings → General → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Project Settings → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
